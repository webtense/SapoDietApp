generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  passwordHash    String?
  name            String?
  displayName     String?
  role            String        @default("USER")
  status          String        @default("INVITED")
  timezone        String?
  phone           String?
  phoneVerified   Boolean       @default(false)
  lastLoginAt     DateTime?
  invitedById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  invitedBy       User?         @relation("UserInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers    User[]        @relation("UserInvitedBy")
  sessions        Session[]
  profile         Profile?
  goal            Goal?
  mealPlans       MealPlan[]
  exerciseLogs    ExerciseLog[]
  mealLogs        MealLog[]
  shopping        ShoppingList[]
  dailyLogs       DailyLog[]
  invitationsCreated  Invitation[] @relation("InvitationCreatedBy")
  invitationsReceived Invitation[] @relation("InvitationAcceptedUser")
  loginEvents         LoginEvent[]
  modules             UserModule[]
  pricing             UserPricing?
  reminders           Reminder[]
  aiTokensUsed       Int         @default(0)
  aiTokenLimit       Int         @default(1)
  lastAiTokenReset   DateTime?
  foodAnalyses       FoodAnalysis[]
  evolutionMsgs      EvolutionMsg[]
  pushSubscriptions  PushSubscription[]
  reviews            Review[]
  subscriptionStatus String      @default("FREE")
  stripeCustomerId   String?     @unique
  stripeSubscriptionId String?   @unique
  workoutPlans       WorkoutPlan[] @relation("WorkoutPlan")
  workoutSessions    WorkoutSession[] @relation("WorkoutSession")
  weightEntries      WeightEntry[] @relation("WeightEntry")
  bodyMeasurements   BodyMeasurement[] @relation("BodyMeasurement")
  bodyPhotos         BodyPhoto[] @relation("BodyPhoto")
  userChallenges     UserChallenge[] @relation("UserChallenge")
  achievements       Achievement[] @relation("Achievement")
  nutritionistPlan   NutritionistPlan? @relation("NutritionistPlan")
  pantryItems        PantryItem[] @relation("PantryItem")
  eatingOutLogs      EatingOutLog[] @relation("EatingOutLog")

  @@index([status])
  @@index([role])
  @@index([invitedById])
}

model EvolutionMsg {
  id        String   @id @default(cuid())
  userId    String
  platform  String   @default("whatsapp")
  direction String   // 'sent' | 'received'
  fromPhone String?
  toPhone   String?
  content   String
  rawJson   String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([platform, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
  @@index([endpoint])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Invitation {
  id               String    @id @default(cuid())
  email            String
  name             String?
  tokenHash        String    @unique
  status           String    @default("PENDING")
  expiresAt        DateTime
  acceptedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  invitedByUserId  String
  invitedUserId    String?
  priceLabel       String?
  monthlyPrice     Float?

  invitedByUser    User             @relation("InvitationCreatedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  invitedUser      User?            @relation("InvitationAcceptedUser", fields: [invitedUserId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@index([invitedByUserId])
  @@index([invitedUserId])
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserModule {
  id         String   @id @default(cuid())
  userId     String
  moduleKey  String
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleKey])
  @@index([userId])
}

model UserPricing {
  id           String   @id @default(cuid())
  userId       String   @unique
  label        String
  monthlyPrice Float?
  currency     String   @default("EUR")
  notes        String?
  activeFrom   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id                     String   @id @default(cuid())
  userId                  String   @unique
  age                     Int?
  heightCm                Float?
  weightKg                Float?
  bodyType                String?
  sex                     String?
  wakeUpTime              String?
  sleepTime               String?
  lunchTime               String?
  dietType                String?
  forbiddenFoods          String?
  supermarket             String?
  trainingFrequency        String?
  trainingPlaces          String?
  homeEquipment           String?
  postalCode               String?
  onboardingCompleted      Boolean  @default(false)
  lastCalculatedCalories  Float?
  lastCalculatedProtein   Float?
  lastCalculatedCarbs     Float?
  lastCalculatedFat       Float?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id              String    @id @default(cuid())
  userId           String    @unique
  targetWeightKg   Float?
  targetWeeks      Int?
  targetDate       DateTime?
  viabilityStatus  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MealPlan {
  id            String   @id @default(cuid())
  userId        String
  planJson      String
  caloriesTarget Float
  proteinTarget  Float
  carbsTarget    Float
  fatTarget      Float
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model MealLog {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime
  mealType       String
  completed      Boolean  @default(false)
  consumedAt     DateTime?
  imagePath      String?
  caloriesActual Float?
  notes          String?
  followsPlan    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@unique([userId, date, mealType])
}

model ExerciseLog {
  id         String   @id @default(cuid())
  userId     String
  date       DateTime
  exerciseId String
  completed  Boolean  @default(false)
  durationSec Int     @default(0)
  setsJson   String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@unique([userId, date, exerciseId])
}

model ShoppingList {
  id             String          @id @default(cuid())
  userId         String
  supermarket    String
  totalEstimated Float
  createdAt      DateTime        @default(now())
  items          ShoppingItem[]
  shares         ShoppingShare[]
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ShoppingItem {
  id              String                    @id @default(cuid())
  shoppingListId  String
  name            String
  amount          Float
  unit            String
  category        String
  aisle           String
  purchased       Boolean                   @default(false)
  estimatedPrice  Float?
  actualPrice     Float?
  shoppingList    ShoppingList              @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  priceObservations ShoppingPriceObservation[]

  @@index([shoppingListId])
}

model ShoppingShare {
  id             String       @id @default(cuid())
  userId         String
  shoppingListId String
  tokenHash      String       @unique
  sharePhone     String?
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ShoppingPriceObservation {
  id             String       @id @default(cuid())
  shoppingItemId String
  userId         String
  supermarket    String
  postalCode     String?
  regionKey      String?
  itemName       String
  unit           String
  observedPrice  Float
  source         String       @default("manual")
  createdAt      DateTime     @default(now())
  shoppingItem   ShoppingItem @relation(fields: [shoppingItemId], references: [id], onDelete: Cascade)

  @@index([itemName, supermarket])
  @@index([regionKey, itemName])
}

model DailyLog {
  id                 String   @id @default(cuid())
  userId              String
  date                DateTime
  caloriesConsumed    Float?
  caloriesTarget      Float?
  waterLiters         Float?
  waterTarget         Float?
  weightKg            Float?
  energy              Int?
  mood                Int?
  mealsCompleted      Int      @default(0)
  totalMeals          Int      @default(0)
  exercisesCompleted  Int      @default(0)
  totalExercises      Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model Reminder {
  id        String   @id @default(cuid())
  userId    String
  kind      String   @default("CUSTOM")
  title     String
  time      String
  days      String
  enabled   Boolean  @default(true)
  system    Boolean  @default(false)
  lastSentAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FoodAnalysis {
  id          String   @id @default(cuid())
  userId      String
  imageHash   String
  calories    Float?
  protein     Float?
  carbs       Float?
  fat         Float?
  ingredients String?
  mealType    String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

// Reseñas de testers/usuarios recogidas manualmente o desde la app,
// mostradas en el dashboard de métricas (/admin/dashboard).
model Review {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  rating    Int
  comment   String?
  source    String   @default("MANUAL") // MANUAL | APP
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([approved, createdAt])
}

// Publicaciones de Instagram, cargadas vía Graph API (si hay token configurado)
// o dadas de alta a mano desde el dashboard de métricas.
model InstagramPost {
  id        String   @id @default(cuid())
  externalId String? @unique
  permalink String?
  caption   String?
  imageUrl  String?
  likes     Int      @default(0)
  comments  Int      @default(0)
  postedAt  DateTime
  source    String   @default("MANUAL") // MANUAL | API
  createdAt DateTime @default(now())

  @@index([postedAt])
}

// Parámetros de marketing editables desde el dashboard (p.ej. inversión
// mensual en ads) usados para calcular KPIs como el CAC.
model MarketingSetting {
  key       String   @id
  value     Float
  updatedAt DateTime @updatedAt
}

// ==== GIMNASIO Y ENTRENAMIENTO ====

model Gym {
  id          String        @id @default(cuid())
  name        String
  location    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  machines    GymMachine[]
}

model MachineModel {
  id                 String        @id @default(cuid())
  name               String
  group              String        @default("FULL") // UPPER | LOWER | FULL
  description        String?
  instructions       String?
  tips               String?
  recommendedWeight  Float?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  gymMachines        GymMachine[]
  exercises          Exercise[]
}

model GymMachine {
  id              String        @id @default(cuid())
  gymId           String
  machineModelId  String
  active          Boolean       @default(true)
  assetNumber     String?
  notes           String?
  internalQRCode  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  gym             Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  machineModel    MachineModel  @relation(fields: [machineModelId], references: [id], onDelete: Cascade)
  weightOptions   MachineWeightOption[]
  workoutExercises WorkoutExercise[]

  @@unique([gymId, machineModelId])
}

model MachineWeightOption {
  id            String        @id @default(cuid())
  gymMachineId  String
  weight        Float
  createdAt     DateTime      @default(now())
  gymMachine    GymMachine    @relation(fields: [gymMachineId], references: [id], onDelete: Cascade)

  @@unique([gymMachineId, weight])
}

model Exercise {
  id              String        @id @default(cuid())
  name            String
  machineModelId  String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  machineModel    MachineModel  @relation(fields: [machineModelId], references: [id], onDelete: Cascade)
  workoutExercises WorkoutExercise[]

  @@unique([machineModelId, name])
}

model WorkoutPlan {
  id              String        @id @default(cuid())
  userId          String
  planType        String        // A | B | C
  exercises       WorkoutExercise[]
  sessions        WorkoutSession[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation("WorkoutPlan", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, planType])
}

model WorkoutSession {
  id              String        @id @default(cuid())
  userId          String
  workoutPlanId   String
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  sets            WorkoutSet[]
  workoutPlan     WorkoutPlan   @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  user            User          @relation("WorkoutSession", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model WorkoutExercise {
  id              String        @id @default(cuid())
  workoutPlanId   String
  order           Int
  exerciseId      String
  gymMachineId    String?
  plannedSets     Int           @default(3)
  plannedReps     Int           @default(12)
  plannedWeight   Float?
  estimatedDuration Int?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  workoutPlan     WorkoutPlan   @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  exercise        Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  gymMachine      GymMachine?   @relation(fields: [gymMachineId], references: [id], onDelete: SetNull)
  sets            WorkoutSet[]

  @@unique([workoutPlanId, order])
}

model WorkoutSet {
  id                  String        @id @default(cuid())
  workoutSessionId    String
  workoutExerciseId   String
  setNumber           Int
  weight              Float
  reps                Int
  rir                 Int?          // Reps in Reserve
  rpe                 Int?          // Rate of Perceived Exertion
  completed           Boolean       @default(true)
  skipped             Boolean       @default(false)
  durationSeconds     Int?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  workoutSession      WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  workoutExercise     WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@unique([workoutSessionId, workoutExerciseId, setNumber])
}

model WeightEntry {
  id              String        @id @default(cuid())
  userId          String
  weight          Float
  date            DateTime      @default(now())
  notes           String?
  createdAt       DateTime      @default(now())
  user            User          @relation("WeightEntry", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model BodyMeasurement {
  id              String        @id @default(cuid())
  userId          String
  bodyPart        String        // chest, arms, waist, legs, etc.
  measurement     Float         // cm
  date            DateTime      @default(now())
  notes           String?
  createdAt       DateTime      @default(now())
  user            User          @relation("BodyMeasurement", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, bodyPart, date])
}

model BodyPhoto {
  id              String        @id @default(cuid())
  userId          String
  pose            String        // front, back, side, etc.
  imagePath       String
  date            DateTime      @default(now())
  notes           String?
  createdAt       DateTime      @default(now())
  user            User          @relation("BodyPhoto", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model UserChallenge {
  id              String        @id @default(cuid())
  userId          String
  challengeId     String
  progress        Int           @default(0)
  completed       Boolean       @default(false)
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  challenge       Challenge     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user            User          @relation("UserChallenge", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
}

model Challenge {
  id              String        @id @default(cuid())
  name            String
  description     String?
  icon            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  userChallenges  UserChallenge[]
}

model Achievement {
  id              String        @id @default(cuid())
  userId          String
  type            String
  description     String?
  unlockedAt      DateTime      @default(now())
  user            User          @relation("Achievement", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model BackupLog {
  id              String        @id @default(cuid())
  trigger         String        // MANUAL | SCHEDULED | AUTO
  status          String        // SUCCESS | FAILED
  backupPath      String?
  errorMessage    String?
  createdAt       DateTime      @default(now())
  completedAt     DateTime?
}

// ───────────────────────────────────────────────────────────────────────────────
// NUTRICIÓN: Plan de nutricionista (fuente de verdad) + Recetas + Comida familiar
// ───────────────────────────────────────────────────────────────────────────────

model NutritionistPlan {
  id                  String        @id @default(cuid())
  userId              String        @unique
  user                User          @relation("NutritionistPlan", fields: [userId], references: [id], onDelete: Cascade)
  pdfOriginal         String?       // URL o path del PDF original
  extractedText       String?       // Texto extraído del PDF
  mealsJson           String?       // JSON estructurado: {desayuno: {...}, mediaMañana: {...}, ...}
  equivalencesJson    String?       // JSON de grupos de sustitución
  status              String        @default("ACTIVE") // ACTIVE | ARCHIVED
  version             Int           @default(1)
  needsReview         Boolean       @default(false) // si hay reglas no legibles con seguridad
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  households          HouseholdMember[]

  @@index([userId, status])
}

model HouseholdMember {
  id                  String        @id @default(cuid())
  nutritionistPlanId  String
  plan                NutritionistPlan @relation(fields: [nutritionistPlanId], references: [id], onDelete: Cascade)
  name                String        // Ej: "Zoraida", "Andrés", "hijo1"
  age                 Int?
  portionFactor       Float         @default(1.0) // 1.0 = ración normal, 0.5 = media ración
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([nutritionistPlanId])
}

model Recipe {
  id                  String        @id @default(cuid())
  name                String
  description         String?
  mealType            String        // DESAYUNO | MEDIA_MAÑANA | COMIDA | MERIENDA | CENA
  servings            Int           @default(1)
  preparationTime     Int?          // minutos
  cookingTime         Int?          // minutos
  difficulty          String        @default("NORMAL") // FACIL | NORMAL | DIFICIL
  method              String        @default("PLANCHA") // PLANCHA | HORNO | CAZUELA | FREIDORA_AIRE | COCIDO
  canFreeze           Boolean       @default(false)
  nutritionPerServing String?       // JSON: {calories, protein, carbs, fat, fiber}
  allergens           String?       // JSON: ["gluten", "marisco", ...]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  ingredients         RecipeIngredient[]
  variants            RecipeVariant[]

  @@index([mealType])
}

model RecipeIngredient {
  id                  String        @id @default(cuid())
  recipeId            String
  recipe              Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient          String        // Ej: "Pechuga de pollo"
  rawWeight           Float?        // en gramos
  cookedWeight        Float?        // en gramos
  drainedWeight       Float?        // en gramos (para conservas)
  frozenWeight        Float?        // en gramos
  substitutionGroup   String?       // Ej: "PROTEINA_BLANCA" para poder intercambiar por otro
  createdAt           DateTime      @default(now())

  @@index([recipeId, substitutionGroup])
}

model RecipeVariant {
  id                  String        @id @default(cuid())
  recipeId            String
  recipe              Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name                String        // "Versión rápida", "Casera", "Elaborada"
  description         String?
  createdAt           DateTime      @default(now())

  @@index([recipeId])
}

model SubstitutionGroup {
  id                  String        @id @default(cuid())
  name                String        @unique // "PROTEINA_BLANCA", "HIDRATOS", "VERDURAS_VERDES"
  category            String        // PROTEINA | HIDRATOS | VERDURAS | FRUTAS
  createdAt           DateTime      @default(now())

  items               SubstitutionItem[]

  @@index([category])
}

model SubstitutionItem {
  id                  String        @id @default(cuid())
  groupId             String
  group               SubstitutionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name                String        // "Pollo", "Pavo", "Merluza", "Arroz blanco"
  standardWeight      Float         // peso en gramos (referencia para intercambiar)
  caloriesPer100g     Float?
  proteinPer100g      Float?
  createdAt           DateTime      @default(now())

  @@unique([groupId, name])
  @@index([groupId])
}

model PantryItem {
  id                  String        @id @default(cuid())
  userId              String
  user                User          @relation("PantryItem", fields: [userId], references: [id], onDelete: Cascade)
  name                String
  quantity            Float
  unit                String        // g | kg | ml | l | unidad
  expiresAt           DateTime?
  recognizedAt        DateTime      @default(now())
  createdAt           DateTime      @default(now())

  @@index([userId, expiresAt])
}

model EatingOutLog {
  id                  String        @id @default(cuid())
  userId              String
  user                User          @relation("EatingOutLog", fields: [userId], references: [id], onDelete: Cascade)
  restaurant          String?
  mealType            String        // COMIDA | CENA
  selectedOption      String?       // Descripción de lo que comió
  estimatedCalories   Float?
  estimatedProtein    Float?
  notes               String?
  createdAt           DateTime      @default(now())

  @@index([userId, createdAt])
}
