{
  "name": "SapoFit",
  "description": "Aplicación de nutrición y entrenamiento con persistencia SQLite",
  "git": null,
  "build": {
    "command": "npm run build",
    "framework": "next"
  },
  "run": {
    "command": "npm run start",
    "port": 3000
  },
  "environment": {
    "DATABASE_URL": "file:./dev.db",
    "SESSION_COOKIE_NAME": "sapofit_session",
    "SESSION_DAYS": "7",
    "APP_URL": "https://sapofit.semillasdeti.com",
    "CRON_SECRET": "change-this-secret"
  },
  "domains": ["sapofit.semillasdeti.com"],
  "php": null
}
